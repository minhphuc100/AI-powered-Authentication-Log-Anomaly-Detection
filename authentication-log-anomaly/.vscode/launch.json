{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Desktop App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_desktop_app.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
